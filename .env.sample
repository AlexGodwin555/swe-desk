# WhatsApp
WHATSAPP_AUTH_DIR=.auth/whatsapp
WHATSAPP_ADMIN_NUMBERS=

# Google Sheets source of truth
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
# Optional alternative to email/private key, if your deploy can mount a credentials JSON file
GOOGLE_APPLICATION_CREDENTIALS=

# Admin access
# Optional access code for /admin. Keep this secret.
ADMIN_ACCESS_CODE=

# Optional MongoDB memory/audit support. Bot still runs without it.
MONGODB_URI=

# Optional tuning
CACHE_TTL_MS=30000
